# SPDX-FileCopyrightText: no
# SPDX-License-Identifier: CC0-1.0
#
# Larch-specific: larch-base's squashfs is also a live-boot medium, so
# it ships mkinitcpio config for THAT (archiso hooks, an "archiso"-only
# preset) and no kernel at all (moved out to the ISO's own boot media
# before the squashfs is built). unpackfs carries the former into the
# install target unchanged and never provides the latter. This runs
# right after unpackfs to clean up the mkinitcpio config and copy the
# kernel back in, before initcpiocfg/initcpio regenerate the initramfs.
---
type:       "job"
name:       "larch-preinstall"
interface:  "python"
script:     "main.py"
